---
layout: null
sitemap: false
permalink: /publications.json
---
{% assign paper_entries = site.publications | sort: 'date' | reverse %}
{
  "author": "Zhanghao Zhouyin",
  "author_url": {{ '/' | absolute_url | jsonify }},
  "papers": [
  {% for paper in paper_entries %}
    {
      "url": {{ paper.url | absolute_url | jsonify }},
      "title": {{ paper.title | jsonify }},
      "authors": {{ paper.paper_authors | jsonify }},
      "publication_year": "{% if paper.citation_date %}{{ paper.citation_date }}{% else %}{{ paper.date | date: '%Y' }}{% endif %}",
      "venue": {{ paper.venue | default: '' | jsonify }},
      "doi": {{ paper.doi | default: '' | jsonify }},
      "paper_url": {{ paper.paperurl | jsonify }},
      "preprint_url": {{ paper.preprint_url | default: '' | jsonify }},
      "research_url": {% if paper.research_url %}{{ paper.research_url | absolute_url | jsonify }}{% else %}""{% endif %},
      "summary": {{ paper.excerpt | default: '' | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  ]
}
